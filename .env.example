# EIA (Energy Information Administration) Data API
# Free registration: https://www.eia.gov/opendata/
# Required only to run scripts/fetch_eia.py — not needed at app runtime
EIA_API_KEY=your_eia_api_key_here

# Mapbox GL JS — interactive U.S. basin map
# https://account.mapbox.com/access-tokens/
# Required: the map panel will not render without this
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Anthropic Claude API — powers the AI Analyst panel
# https://console.anthropic.com/
# Optional: if not set, the AI Analyst panel shows an unavailable notice
# The rest of the dashboard works normally without it
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
